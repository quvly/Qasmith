{
  "scopeName": "source.qasmith",
  "patterns": [
    {
      "name": "comment.block.qasmith",
      "begin": "/\\*",
      "end": "\\*/"
    },
    {
      "name": "comment.line.double-slash.qasmith",
      "match": "//.*$"
    },
    {
      "name": "string.quoted.double.import.qasmith",
      "begin": "(?<=\\bfrom)\\s*\"",
      "end": "\"|$",
      "patterns": [
        {
          "name": "constant.character.escape.qasmith",
          "match": "\\\\."
        }
      ]
    },
    {
      "name": "string.quoted.double.qasmith",
      "begin": "\"",
      "end": "\"|$",
      "patterns": [
        {
          "name": "constant.character.escape.qasmith",
          "match": "\\\\."
        }
      ]
    },
    {
      "name": "meta.function.declaration.qasmith",
      "match": "\\b(fn)\\s+([A-Za-z_][A-Za-z_0-9]*)",
      "captures": {
        "1": {
          "name": "storage.type.function.qasmith"
        },
        "2": {
          "name": "entity.name.function.qasmith"
        }
      }
    },
    {
      "name": "storage.modifier.qasmith",
      "match": "\\bpub\\b"
    },
    {
      "name": "keyword.control.qasmith",
      "match": "\\b(?:fn|import|from|as|let|return|for|in|if|else)\\b"
    },
    {
      "name": "constant.language.boolean.qasmith",
      "match": "\\b(?:true|false)\\b"
    },
    {
      "name": "meta.type.parameters.qasmith",
      "begin": "\\b(QReg)\\s*(<)",
      "end": ">|(?=[;{})\\n])",
      "beginCaptures": {
        "1": {
          "name": "support.type.qasmith"
        },
        "2": {
          "name": "punctuation.definition.type.qasmith"
        }
      },
      "patterns": [
        {
          "name": "constant.numeric.qasmith",
          "match": "\\b[0-9]+\\b"
        }
      ]
    },
    {
      "name": "support.type.qasmith",
      "match": "\\b(?:Int|Float|Bool|Void|Qubit|QReg|MeasuredResult|OptimizationProblem|QuboModel|QuboSolution)\\b"
    },
    {
      "name": "support.function.quantum.qasmith",
      "match": "\\b(?:qubit|qreg|h|x|cx|rx|ry|rz|measure)\\b(?=\\s*\\()"
    },
    {
      "name": "entity.name.function.call.qasmith",
      "match": "\\b[A-Za-z_][A-Za-z_0-9]*(?=\\s*\\()"
    },
    {
      "name": "constant.numeric.qasmith",
      "match": "(?:(?<=\\.\\.)|(?<![A-Za-z_0-9.]))(?:[0-9]+(?:\\.(?!\\.)[0-9]*)?|\\.[0-9]+)(?:[Ee][+-]?[0-9]+)?(?![A-Za-z_0-9])"
    },
    {
      "name": "keyword.operator.type.qasmith",
      "match": "->|:"
    },
    {
      "name": "keyword.operator.qasmith",
      "match": "\\.\\.|&&|\\|\\||==|!=|<=|>=|[+*/%<>=!-]"
    },
    {
      "name": "punctuation.section.brackets.qasmith",
      "match": "[\\[\\]{}()]"
    },
    {
      "name": "punctuation.separator.qasmith",
      "match": "[,;]"
    }
  ]
}
