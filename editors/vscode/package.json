{
  "name": "qasmith-language",
  "displayName": "Qasmith Smith Tools by Quvly",
  "description": "Smith language support and local quantum compiler integration",
  "version": "0.9.0",
  "publisher": "Quvly",
  "icon": "icon.png",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/quvly/Qasmith.git"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "keywords": [
    "qasmith",
    "smith",
    "quantum",
    "openqasm"
  ],
  "activationEvents": [
    "onLanguage:qasmith",
    "onCommand:qasmith.check",
    "onCommand:qasmith.compile",
    "onCommand:qasmith.run",
    "onCommand:qasmith.optimize",
    "onCommand:qasmith.preview",
    "onCommand:qasmith.restart",
    "onCommand:qasmith.output"
  ],
  "main": "./out/src/extension.js",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Highlighting remains available. Starting executable processes requires workspace trust.",
      "restrictedConfigurations": [
        "qasmith.executablePath"
      ]
    }
  },
  "contributes": {
    "languages": [
      {
        "id": "qasmith",
        "aliases": [
          "Qasmith",
          "Smith"
        ],
        "extensions": [
          ".smith"
        ],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "qasmith-openqasm",
        "aliases": [
          "OpenQASM (Qasmith)"
        ],
        "extensions": [
          ".qasm"
        ]
      }
    ],
    "grammars": [
      {
        "language": "qasmith",
        "scopeName": "source.qasmith",
        "path": "./syntaxes/qasmith.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "qasmith",
        "path": "./snippets/qasmith.json"
      }
    ],
    "commands": [
      {
        "command": "qasmith.check",
        "title": "Check Current File",
        "category": "Qasmith"
      },
      {
        "command": "qasmith.compile",
        "title": "Compile Current File",
        "category": "Qasmith"
      },
      {
        "command": "qasmith.run",
        "title": "Run Current File",
        "category": "Qasmith"
      },
      {
        "command": "qasmith.optimize",
        "title": "Optimize Current File",
        "category": "Qasmith"
      },
      {
        "command": "qasmith.preview",
        "title": "Show Generated OpenQASM",
        "category": "Qasmith"
      },
      {
        "command": "qasmith.restart",
        "title": "Restart Language Server",
        "category": "Qasmith"
      },
      {
        "command": "qasmith.output",
        "title": "Show Compiler Output",
        "category": "Qasmith"
      }
    ],
    "configuration": {
      "title": "Qasmith",
      "properties": {
        "qasmith.executablePath": {
          "type": "string",
          "default": "",
          "description": "Absolute path to an installed Qasmith executable.",
          "scope": "machine",
          "restricted": true
        },
        "qasmith.lsp.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable the Qasmith language server."
        },
        "qasmith.lsp.trace": {
          "type": "string",
          "default": "off",
          "description": "Language server protocol tracing.",
          "enum": [
            "off",
            "messages",
            "verbose"
          ]
        },
        "qasmith.diagnostics.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Publish live compiler diagnostics."
        },
        "qasmith.diagnostics.debounceMs": {
          "type": "integer",
          "default": 200,
          "description": "Delay before live analysis.",
          "minimum": 0,
          "maximum": 2000
        },
        "qasmith.run.shots": {
          "type": "integer",
          "default": 1000,
          "description": "Number of circuit samples.",
          "minimum": 1,
          "maximum": 1000000
        },
        "qasmith.run.seed": {
          "type": "integer",
          "default": 42,
          "description": "Deterministic simulation seed.",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "qasmith.optimize.maxEvaluations": {
          "type": "integer",
          "default": 200,
          "description": "Maximum search evaluations.",
          "minimum": 1,
          "maximum": 100000
        },
        "qasmith.optimize.restarts": {
          "type": "integer",
          "default": 3,
          "description": "Additional initial parameter sets.",
          "minimum": 0,
          "maximum": 64
        },
        "qasmith.optimize.evaluationMode": {
          "type": "string",
          "default": "exact",
          "description": "Search objective mode.",
          "enum": [
            "exact",
            "sampled"
          ]
        },
        "qasmith.compile.outputPath": {
          "type": "string",
          "default": "",
          "description": "Optional OpenQASM output path, relative to the source folder when relative."
        },
        "qasmith.verbose": {
          "type": "boolean",
          "default": false,
          "description": "Log command arguments and process details."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p .",
    "lint": "eslint src test --max-warnings 0",
    "test": "node --test out/test/*.unit.js",
    "test:integration": "node out/test/run.js",
    "vscode:prepublish": "npm run compile"
  },
  "dependencies": {
    "vscode-languageclient": "9.0.1"
  },
  "devDependencies": {
    "@types/node": "22.15.3",
    "@types/vscode": "1.90.0",
    "@vscode/test-electron": "2.5.2",
    "@vscode/vsce": "4.1.1",
    "@eslint/js": "9.26.0",
    "eslint": "9.26.0",
    "typescript-eslint": "8.32.1",
    "typescript": "5.8.3",
    "vscode-textmate": "9.2.0",
    "vscode-oniguruma": "2.0.1"
  }
}
