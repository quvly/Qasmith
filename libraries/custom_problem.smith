import { qubo, addLinear, addQuadratic } from "std/optimization/qubo";

pub fn createProblem() -> OptimizationProblem {
    let base = qubo(3, 1.0);
    let a = addLinear(base, 0, -2.0);
    let b = addLinear(a, 1, 3.0);
    let c = addLinear(b, 2, -0.5);
    let d = addQuadratic(c, 0, 1, 4.0);
    return addQuadratic(d, 1, 2, -1.0);
}

pub fn weightedPair(first: Float, second: Float) -> OptimizationProblem {
    let base = qubo(2, 0.0);
    let a = addLinear(base, 0, first);
    return addLinear(a, 1, second);
}
