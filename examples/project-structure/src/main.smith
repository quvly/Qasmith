// Project Structure Example
//
// This example demonstrates Qasmith's project structure conventions:
// - Project manifest (qasmith.toml)
// - Organized source code in src/
// - Local libraries in libraries/
// - Package dependencies in packages/
//
// Run with: qasmith run src/main.smith

import { rzz } from "../libraries/rotations.smith";
import { bell_state } from "./algorithms/bell.smith";
import { add, multiply } from "math-utils/arithmetic";

fn main() -> MeasuredResult {
    // Demonstrate package imports
    let sum = add(5, 3);
    let product = multiply(sum, 2);
    
    // Create quantum register
    let q = qreg(4);
    
    // Apply Bell state to first two qubits
    bell_state(q[0], q[1]);
    
    // Apply RZZ rotation based on classical computation
    let angle = 0.1 * product;
    rzz(angle, q[2], q[3]);
    
    // Entangle all qubits
    cx(q[0], q[2]);
    cx(q[1], q[3]);
    
    return measure(q);
}
