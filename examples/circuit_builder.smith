import { rzz } from "./libraries/rotations.smith";

fn main() -> MeasuredResult {
    let q = qreg(4);

    let weights = [
        [0.0, 0.2, 0.4, 0.6],
        [0.2, 0.0, 0.8, 1.0],
        [0.4, 0.8, 0.0, 1.2],
        [0.6, 1.0, 1.2, 0.0]
    ];

    for i in 0..4 {
        h(q[i]);
    }

    for i in 0..4 {
        for j in 0..4 {
            if (i < j) {
                rzz(weights[i][j], q[i], q[j]);
            }
        }
    }

    return measure(q);
}
